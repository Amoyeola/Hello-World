          "text": [
            "Pipelines ready.\n"
          ]
        }
      ],
      "source": [
        "# Load the text-to-image pipeline (written for you, just run it)\n",
        "MODEL_ID = \"stable-diffusion-v1-5/stable-diffusion-v1-5\"\n",
        "\n",
        "txt2img = StableDiffusionPipeline.from_pretrained(\n",
        "    MODEL_ID,\n",
        "    torch_dtype=torch.float16 if device == \"cuda\" else torch.float32,\n",
        ")\n",
        "txt2img = txt2img.to(device)\n",
        "txt2img.set_progress_bar_config(disable=True)\n",
        "\n",
        "# Reuse the SAME weights for img2img and inpainting (Part B). No second download.\n",
        "img2img = StableDiffusionImg2ImgPipeline(**txt2img.components).to(device)\n",
        "img2img.set_progress_bar_config(disable=True)\n",
        "\n",
        "print(\"Pipelines ready.\")\n",
        "# Note: occasionally the safety checker returns a black image. If that happens,\n",
        "# nudge your prompt or change the seed by 1 and rerun."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 24,
      "id": "8a7b24dc",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 0
        },
        "id": "8a7b24dc",
        "outputId": "af203ac7-c2a6-44fc-a046-43d17c3ad42d"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Helpers loaded: save_image(), generate(), show_row()\n"
          ]
        }
      ],
      "source": [
        "# Helper functions (written for you — read them, then use them)\n",
        "\n",
        "def _caption(img, text):\n",
        "    \"\"\"Stamp a caption bar under the image so settings are baked into the picture.\"\"\"\n",
        "    bar_h = 38\n",
        "    canvas = Image.new(\"RGB\", (img.width, img.height + bar_h), \"white\")\n",
        "    canvas.paste(img, (0, 0))\n",
        "    draw = ImageDraw.Draw(canvas)\n",
        "    try:\n",
        "        font = ImageFont.truetype(\"/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\", 16)\n",
        "    except Exception:\n",
        "        font = ImageFont.load_default()\n",
        "    draw.text((8, img.height + 9), text, fill=\"black\", font=font)\n",
        "    return canvas\n",
        "\n",
        "\n",
        "def save_image(img, label, seed, steps, guidance, show=True):\n",
        "    \"\"\"Caption an image with its exact settings and save it to outputs/.\n",
        "\n",
        "    The caption format is:  label | seed / steps / guidance\n",
        "    Use this for EVERY figure so your captions are automatic and consistent.\n",
        "    Returns the captioned image.\n",
        "    \"\"\"\n",
        "    cap = f\"{label} | {seed} / {steps} / {guidance}\"\n",
        "    out = _caption(img, cap)\n",
        "    safe = \"\".join(c if c.isalnum() else \"_\" for c in label)\n",
        "    path = f\"outputs/{safe}_{seed}_{steps}_{guidance}.png\"\n",
        "    out.save(path)\n",
        "    if show:\n",
        "        from IPython.display import display\n",
        "        display(out)\n",
        "    print(\"saved:\", path)\n",
        "    return out\n",
        "\n",
        "\n",
        "def generate(prompt, seed, steps, guidance, negative_prompt=None):\n",
        "    \"\"\"Text-to-image with a LOCKED seed. Same inputs -> same image, every time.\"\"\"\n",
        "    generator = torch.Generator(device=device).manual_seed(int(seed))\n",
        "    result = txt2img(\n",
        "        prompt=prompt,\n",
        "        negative_prompt=negative_prompt,\n",
        "        num_inference_steps=int(steps),\n",
        "        guidance_scale=float(guidance),\n",
        "        generator=generator,\n",
        "    )\n",
        "    return result.images[0]\n",
        "\n",
        "\n",
        "def show_row(images, titles):\n",
        "    \"\"\"Display several captioned images side by side for a sweep.\"\"\"\n",
        "    import matplotlib.pyplot as plt\n",
        "    n = len(images)\n",
        "    fig, axes = plt.subplots(1, n, figsize=(5 * n, 5))\n",
        "    if n == 1:\n",
        "        axes = [axes]\n",
        "    for ax, im, t in zip(axes, images, titles):\n",
        "        ax.imshow(im)\n",
        "        ax.set_title(t)\n",
        "        ax.axis(\"off\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "print(\"Helpers loaded: save_image(), generate(), show_row()\")"
      ]
    },
    {
