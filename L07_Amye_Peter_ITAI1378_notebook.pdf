        "# Setup cell 2 of 2 — imports + GPU check (written for you, just run it)\n",
        "import torch\n",
        "from diffusers import (\n",
        "    StableDiffusionPipeline,\n",
        "    StableDiffusionImg2ImgPipeline,\n",
        "    StableDiffusionInpaintPipeline,\n",
        ")\n",
        "from PIL import Image, ImageDraw, ImageFont\n",
        "import os, textwrap\n",
        "\n",
        "# Folder where every saved figure lands, so your PDF export shows them all.\n",
        "os.makedirs(\"outputs\", exist_ok=True)\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "    device = \"cuda\"\n",
        "    print(\"GPU detected:\", torch.cuda.get_device_name(0))\n",
        "else:\n",
        "    device = \"cpu\"\n",
        "    print(\"WARNING: No GPU. Set Runtime > Change runtime type > GPU, then rerun from the top.\")\n",
        "    print(\"On CPU this lab will be extremely slow.\")"
      ]
