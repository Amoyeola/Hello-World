      "source": [
        "# Part B (img2img) — TODO\n",
        "# strength controls how much of your photo is kept: low = subtle edit, high = heavy change.\n",
        "EDIT_PROMPT = \"Turn this car into a classic 1960s vintage automobile.\"   # TODO: how you want your photo re-imagined\n",
        "STRENGTH    = 0.8  # TODO: tune between ~0.3 and ~0.8\n",
        "EDIT_SEED   = SIGNATURE_SEED\n",
        "EDIT_STEPS  = 30\n",
        "EDIT_GUID   = 7\n",
        "\n",
        "assert EDIT_PROMPT, \"Write an edit prompt for your photo.\"\n",
        "\n",
        "generator = torch.Generator(device=device).manual_seed(int(EDIT_SEED))\n",
        "# TODO: call img2img(prompt=EDIT_PROMPT, image=init_image, strength=STRENGTH,\n",
        "#                    num_inference_steps=EDIT_STEPS, guidance_scale=EDIT_GUID,\n",
        "#                    generator=generator).images[0]\n",
        "edited = img2img(\n",
        "    prompt=EDIT_PROMPT,\n",
        "    image=init_image,\n",
        "    strength=STRENGTH,\n",
        "    num_inference_steps=EDIT_STEPS,\n",
        "    guidance_scale=EDIT_GUID,\n",
        "    generator=generator\n",
        "    ).images[0]  # TODO\n",
        "\n",
        "# TODO: caption + save. Reuse save_image(); put strength in the label, e.g.\n",
        "# save_image(edited, f\"B_img2img_str{STRENGTH}\", EDIT_SEED, EDIT_STEPS, EDIT_GUID)\n",
        "\n",
        "save_image(\n",
        "    edited,\n",
        "    f\"B_img2img_str{STRENGTH}\",\n",
        "    EDIT_SEED,\n",
        "    EDIT_STEPS,\n",
        "    EDIT_GUID\n",
        ")"
      ]
    },
