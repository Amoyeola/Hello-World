      ],
      "source": [
        "# Part C — TODO: pick a failure mode and trigger it\n",
        "FAILURE_MODE   = \"counting\"  # TODO: one of \"counting\", \"hands\", \"identities\", \"diagrams\"\n",
        "FAILURE_PROMPT = \"A realistic photo of exactly seven red apples on a wooden table, no other fruit, clear lighting\"  # TODO: a prompt designed to expose that weakness\n",
        "FAIL_STEPS, FAIL_GUID = 30, 7\n",
        "\n",
        "assert FAILURE_MODE in {\"counting\", \"hands\", \"identities\", \"diagrams\"}, \"Choose a valid failure mode.\"\n",
        "assert FAILURE_PROMPT, \"Write a prompt that triggers the failure.\"\n",
        "\n",
        "# TODO: generate() with FAILURE_PROMPT, SIGNATURE_SEED, FAIL_STEPS, FAIL_GUID\n",
        "fail_img = generate(\n",
        "    FAILURE_PROMPT,\n",
        "    seed=SIGNATURE_SEED,\n",
        "    steps=FAIL_STEPS,\n",
        "    guidance=FAIL_GUID\n",
        "    )   # TODO\n",
        "\n",
        "# TODO: save_image(...) with a label like f\"C_{FAILURE_MODE}\"\n",
        "save_image(\n",
        "    fail_img,\n",
        "    f\"C_{FAILURE_MODE}\",\n",
        "    SIGNATURE_SEED,\n",
        "    FAIL_STEPS,\n",
        "    FAIL_GUID\n",
        "    )\n",
        "# You will explain WHY it failed in your report (Part D), not here."
      ]
    },
    {
